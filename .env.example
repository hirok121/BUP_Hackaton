# Required: your LLM API key.
LLM_API_KEY=

# Optional: model to use (default: gpt-4o). Provider defaults to openai.
LLM_MODEL=gpt-4o

# --- Advanced (defaults are fine for most setups) ---
# LLM_PROVIDER=openai        # openai, anthropic, google, groq, or local
# LLM_BASE_URL=              # for a local/proxied OpenAI-compatible endpoint
# LLM_TIMEOUT_S=3.5
# LLM_MAX_RETRIES=1
# LLM_STAGE_BUDGET_S=8.0
# FALLBACK_PROVIDER=
# FALLBACK_API_KEY=
# FALLBACK_MODEL=
# PORT=8000
# LOG_LEVEL=info
